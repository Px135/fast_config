{
  //Repositorio oiginal: https://github.com/ImKruma/fastfetch_dotfiles
  //Modificado por: https://github.com/ImKruma/fastfetch_dotfiles

  "logo": {
    "type": "auto",
    "source": "${HOME}/.config/fastfetch/Img-fast/5.png",
    "height": 18,
    "padding": {
      "top": 0,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "key": "╭────────────╮",
      "keyColor": "#EE3C75"
    },
    {
      "key": "│  User     │",
      "type": "title",
      "format": "{host-name}",
      "keyColor": "#EE3C75"
    },
    {
      "type": "custom",
      "key": "├────────────┤",
      "keyColor": "#EE3C75"
    },
    {
      "type": "os",
      "key": "│ {icon} OS       │",
      "format": "{name}  ",
      "keyColor": "#EE3C75"
    },
    {
      "type": "kernel",
      "key": "│  Kernel   │",
      "keyColor": "#EE3C75"
    },
    {
      "type": "de",
      "key": "│  DE       │",
      "keyColor": "#EE3C75"
    },
    {
      "type": "wm",
      "key": "│  WM       │",
      "keyColor": "#EE3C75"
    },
    {
      "type": "wmtheme",
      "key": "│  DE/WM    │",
      "keyColor": "#EE3C75",
      "disabled": [
        "apk"
      ],
      "combined": false
    },
    {
      "type": "custom",
      "key": "╰────────────╯",
      "keyColor": "#EE3C75"
    },
    {
      "type": "custom",
      "key": "╭────────────╮"
    },
    {
      "type": "memory",
      "key": "│  Memory   │",
      "format": "{used} / {total} "
    },
    {
      "type": "disk",
      "key": "│  Disk     │",
      "format": "{size-used} / {size-total} "
    },
    {
      "type": "swap",
      "key": "│  Swap     │",
      "format": "{used} / {total}"
    },
    {
      "type": "cpu",
      "key": "│  CPU      │",
      "format": "{name} ({cores-logical})"
    },
    {
      "type": "gpu",
      "key": "│  GPU      │",
      "format": "{vendor} {name} ({type})"
    },
    {
      "type": "terminal",
      "key": "│  Terminal │"
    },
    {
      "type": "battery",
      "key": "│  Battery  │"
    },
    {
      "type": "custom",
      "key": "╰────────────╯",
    },
    // commented colors, uncomment if you want to use it.
    // {
    //   "type": "colors",
    //   "key": " ",
    //   "keyIcon": "",
    //   "symbol": "circle",
    //   "paddingLeft": 20,
    //   "block": {
    //     "width": 3,
    //     "range": [
    //       0,
    //       15
    //     ]
    //   }
    // }
  ]
}
